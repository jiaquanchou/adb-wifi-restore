<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/status_summary"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Permission -->
        <LinearLayout style="@style/Card"
            android:layout_marginBottom="12dp">
            <TextView style="@style/CardTitle"
                android:text="@string/card_permission_title" />
            <TextView
                android:id="@+id/permission_state"
                style="@style/CardBody"
                android:layout_marginTop="6dp"
                android:text="@string/permission_missing" />
            <TextView
                android:id="@+id/grant_cmd"
                style="@style/MonoText"
                android:layout_marginTop="10dp" />
            <Button
                android:id="@+id/btn_copy_grant"
                style="@style/CardButton"
                android:layout_marginTop="6dp"
                android:text="@string/btn_copy" />
            <TextView
                android:id="@+id/whitelist_cmd"
                style="@style/MonoText"
                android:layout_marginTop="10dp" />
            <Button
                android:id="@+id/btn_copy_whitelist"
                style="@style/CardButton"
                android:layout_marginTop="6dp"
                android:text="@string/btn_copy" />
        </LinearLayout>

        <!-- Wireless debugging state -->
        <LinearLayout style="@style/Card"
            android:layout_marginBottom="12dp">
            <TextView style="@style/CardTitle"
                android:text="@string/card_adb_title" />
            <TextView
                android:id="@+id/adb_state"
                style="@style/CardBody"
                android:layout_marginTop="6dp" />
            <TextView
                android:id="@+id/wifi_state"
                style="@style/CardBody"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/adb_error"
                style="@style/CardBody"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btn_restore_now"
                style="@style/CardButton"
                android:layout_marginTop="10dp"
                android:text="@string/btn_restore_now" />
        </LinearLayout>

        <!-- Connect command -->
        <LinearLayout style="@style/Card"
            android:layout_marginBottom="12dp">
            <TextView style="@style/CardTitle"
                android:text="@string/card_connect_title" />
            <TextView
                android:id="@+id/connect_cmd"
                style="@style/MonoText"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btn_copy_connect"
                style="@style/CardButton"
                android:layout_marginTop="6dp"
                android:text="@string/btn_copy" />
        </LinearLayout>

        <!-- Device IPs -->
        <LinearLayout style="@style/Card"
            android:layout_marginBottom="12dp">
            <TextView style="@style/CardTitle"
                android:text="@string/card_ips_title" />
            <TextView
                android:id="@+id/ips_text"
                style="@style/MonoText"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- HTTP reporter -->
        <LinearLayout style="@style/Card"
            android:layout_marginBottom="12dp">
            <TextView style="@style/CardTitle"
                android:text="@string/card_http_title" />
            <TextView
                android:id="@+id/http_state"
                style="@style/CardBody"
                android:layout_marginTop="6dp" />
            <TextView
                android:id="@+id/curl_example"
                style="@style/MonoText"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btn_copy_curl"
                style="@style/CardButton"
                android:layout_marginTop="6dp"
                android:text="@string/btn_copy" />
        </LinearLayout>

        <!-- Raw status -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle"
                android:text="@string/card_detail_title" />
            <TextView
                android:id="@+id/detail_json"
                style="@style/MonoText"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
